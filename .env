# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- Database ----
# SQLite file used by the prototype. Swap for a PostgreSQL connection string
# in production (see README "Moving to PostgreSQL").
DB_PATH=./data/waste_platform.sqlite

# ---- Auth ----
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ---- Business rules (tunable without touching code) ----
POINTS_PER_CORRECT_SEGREGATION=10
POINTS_PENALTY_PER_INCORRECT=0
SEGREGATION_CONFIDENCE_THRESHOLD=0.6
BIN_FILL_ALERT_THRESHOLD=70
VEHICLE_CAPACITY_STOPS=25

# ---- Sustainability estimates (used by the dashboard) ----
FUEL_COST_PER_KM_LITERS=0.35
CO2_KG_PER_LITER_DIESEL=2.68
CO2_KG_SAVED_PER_KG_RECYCLED=1.5

# ---- File uploads ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5
